# Sao chép thành `.env` rồi điền giá trị thật. KHÔNG commit `.env`.
# Mọi biến ở đây được đọc bởi `rag_core.settings.Settings`.

# ---------------------------------------------------------------- LLM API
# Provider chính cho serving và cho việc sinh nháp golden set.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Fallback + judge cross-check khác họ model.
# QUY TẮC CỨNG: cấm dùng `@preset/...` trong đường eval — preset là config phía
# server, có thể đổi ngầm làm metric dịch mà không truy được nguyên nhân.
# Luôn pin slug tường minh và log lại field `model` mà response trả về.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Provider rẻ hơn cho job sinh dữ liệu hàng loạt (`W3-04`). Giá công bố
# $0,15/1M input · $0,50/1M output · $0,03/1M cached, tức rẻ hơn DeepSeek
# 1,8×–2,2×. Endpoint quốc tế là api.z.ai; bản đại lục là open.bigmodel.cn.
GLM_API_KEY=
GLM_BASE_URL=https://api.z.ai/api/paas/v4

# Chỉ cần khi tải model private hoặc đẩy corpus lên HF dataset repo cho job GPU thuê.
HF_TOKEN=

# ---------------------------------------------------------------- Hạ tầng
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_chunks

POSTGRES_USER=rag
POSTGRES_PASSWORD=rag_local_dev_only
POSTGRES_DB=rag
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

REDIS_URL=redis://127.0.0.1:6379/0

# Hàng đợi arq cho job ingest (`W3-08`). Hai môi trường dùng chung một Redis mà
# để trùng tên thì worker của bên này nhặt job của bên kia, hỏng vì thiếu config,
# và job biến mất khỏi hàng đợi.
INGEST_QUEUE=arq:queue

# Thư mục DUY NHẤT mà `POST /ingest` được phép đọc config từ đó. Đây là cận trên
# của quyền đọc, không phải một tiện ích: request nhận một *tên*, ghép vào đây,
# rồi kiểm lại rằng đường dẫn kết quả không thoát ra ngoài.
INGEST_CONFIG_DIR=configs/indexing

# `W6-01`: URL của API ingestion để bảng tiến độ trong UI hỏi. Để TRỐNG là tắt —
# một bề mặt điều khiển pipeline mở sẵn ở mọi lần deploy là thứ không ai xin.
INGEST_API_URL=

# `W6-06` / `AU-10`: bí mật dùng chung giữa proxy `/admin/ingest` và dịch vụ
# ingestion. Để TRỐNG thì dịch vụ ấy CHỈ nhận lời gọi loopback — đủ cho máy dev.
# ⚠️ Bắt buộc phải đặt khi hai bên chạy ở hai container/máy khác nhau: khi đó
# client không còn là loopback, và không có token nghĩa là proxy bị chặn.
INGEST_API_TOKEN=

# ------------------------------------------------- Quan sát (Langfuse, W5-06)
# Bật quan sát = có đủ HOST + hai khoá. Không có cờ bật/tắt riêng: một cờ bên
# cạnh một cặp khoá tạo ra trạng thái "bật nhưng chưa có khoá", và trạng thái ấy
# trông y hệt như đang chạy — 200, câu trả lời đúng, bảng Langfuse trống.
#
# Khoá dưới đây là cặp mà `infra/docker-compose.langfuse.yml` tự tạo lúc lên
# lần đầu (`LANGFUSE_INIT_PROJECT_*`), nên `make up-langfuse` là đủ.
#
# ⚠️ Trỏ HOST ra ngoài máy nghĩa là câu hỏi của người dùng và metadata corpus
# rời khỏi máy này. `build_sink()` cảnh báo mỗi lần khởi động khi HOST không
# phải cục bộ; nó KHÔNG chặn, vì đó là quyết định của người vận hành.
LANGFUSE_HOST=http://127.0.0.1:3000
LANGFUSE_PUBLIC_KEY=pk-lf-rag-platform-local
LANGFUSE_SECRET_KEY=sk-lf-rag-platform-local
LANGFUSE_QUEUE_SIZE=256

# ---------------------------------------------------------------- Model
EMBEDDING_MODEL=bkai-foundation-models/vietnamese-bi-encoder
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=32

# ---------------------------------------------------------------- Khác
LOG_LEVEL=INFO
CACHE_DIR=.cache
