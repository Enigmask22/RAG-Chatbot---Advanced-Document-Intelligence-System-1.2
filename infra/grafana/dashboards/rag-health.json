    {
      "type": "stat",
      "title": "Scrape sống?",
      "description": "`max(...)` vì job có hai đích — API chạy trong container (`api:8000`) hoặc trên máy chủ (`host.docker.internal:8000`), và không bao giờ cả hai. Ô ĐẦU TIÊN của bảng, có chủ đích. Prometheus không đọc được /metrics (API tắt, khoá sai, hết hạn mức) làm MỌI ô còn lại trống — và một biểu đồ trống trông y hệt 'không có traffic'. Không có ô này thì cả bảng nói dối một cách im lặng.",
      "datasource": {
        "type": "prometheus",
        "uid": "rag-prom"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(up{job=\"rag-serving\"})",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "KHÔNG SCRAPE ĐƯỢC",
                  "color": "red",
                  "index": 0
                }
              }
            },
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "OK",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Request / giây",
      "description": "rag_http_* đếm ở middleware nên nó thấy CẢ 401/429/404. Bộ đếm dựng từ cây span chỉ thấy lượt đã qua auth — dùng nó một mình thì một sự cố khoá API hiện ra là traffic bằng 0.",
      "datasource": {
        "type": "prometheus",
        "uid": "rag-prom"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 4,
        "y": 1
